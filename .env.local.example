# Copy this file to .env.local and fill in real values.

# Production URL, used to build sitemap.xml and robots.txt. Defaults to https://3plus.az if unset.
NEXT_PUBLIC_SITE_URL=

# Supabase project — Project Settings -> API in the Supabase dashboard.
# Backs the RFQ contact form and the "notify me" sign-up form.
# SUPABASE_SERVICE_ROLE_KEY is secret — server-only, never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only needed if you want the Sanity Studio content-editing UI at /studio.
# Created by running: npx sanity init (inside this project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# WhatsApp number in international format, no + or spaces, e.g. 994101212345
NEXT_PUBLIC_WHATSAPP_NUMBER=
